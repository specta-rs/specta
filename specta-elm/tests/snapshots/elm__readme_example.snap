// src/Types.elm
module Types exposing (..)
-- generated by specta-elm

type ApiResult
    = Success { data: String, status: Int }
    | Error { message: String, code: Int }
    | Loading { progress: Float }

type alias Surname = ( String, String )

type SurnameKind
    = Spanish ( String, String )
    | Other String

type alias User =
    { id: Int
    , name: String
    , surname: Maybe SurnameKind
    , email: Maybe String
    , role: UserRole }

type UserRole
    = Guest
    | Member { permissions: List String }
    | Admin { level: Int, department: String }
